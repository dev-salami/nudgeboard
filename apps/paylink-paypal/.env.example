# Copy to apps/paylink-paypal/.env.local or the monorepo root .env.
# Documented names only. Do not put real PayPal secrets in git.

# PayPal REST app (sandbox). Leave both empty to run the full demo
# without a developer account: invoices, the pay page, and the webhook stub.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live. This hackathon entry is sandbox-only.
PAYPAL_ENVIRONMENT=sandbox
# Required for the real verify-webhook-signature call. Ignored in demo mode.
PAYPAL_WEBHOOK_ID=
# Sandbox business email on the same REST app. PayPal rejects a send when
# this does not match the API credentials. Demo mode uses MERCHANT_EMAIL.
PAYPAL_MERCHANT_EMAIL=

MERCHANT_NAME=Nudgeboard
MERCHANT_CITY=Lagos
MERCHANT_EMAIL=merchant@example.com

# Public origin baked into pay links. The dev server listens on 3030.
APP_URL=http://localhost:3030

# Leave demo mode on for a keyless agent. Set to 0 and provide a key to use a model.
# PayPal demo mode is separate: it follows from empty PAYPAL_CLIENT_ID / SECRET.
PAYLINK_DEMO_MODE=1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional. Without a key, reminders are stored in the app and logged.
RESEND_API_KEY=
RESEND_FROM=Nudgeboard <invoices@example.com>

# Optional override for the JSON store. Docker uses /data.
# DATA_DIR=
