{
  "name": "nudgeboard",
  "private": true,
  "version": "0.1.0",
  "description": "Nudgeboard: a PayPal sandbox invoicing and collections agent (MIT).",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter paylink-paypal dev",
    "build": "pnpm --filter paylink-paypal build",
    "start": "pnpm --filter paylink-paypal start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "smoke:sandbox": "pnpm --filter paylink-paypal smoke:sandbox"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  }
}
