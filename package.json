{
  "name": "181hacks",
  "private": true,
  "version": "0.1.0",
  "description": "Hackathon monorepo. PayLink Agent is the Encode Club Solana Hackathon 2026 entry.",
  "scripts": {
    "dev": "pnpm --filter paylink-solana dev",
    "dev:paypal": "pnpm --filter paylink-paypal dev",
    "build": "pnpm --filter paylink-solana build",
    "build:paypal": "pnpm --filter paylink-paypal build",
    "start": "pnpm --filter paylink-solana start",
    "start:paypal": "pnpm --filter paylink-paypal start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "devnet": "pnpm --filter paylink-solana run setup",
    "pay": "pnpm --filter paylink-solana pay"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  }
}
